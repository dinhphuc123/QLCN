# ==============================================================================
# SỔ CHỦ NHIỆM SỐ - BIẾN MÔI TRƯỜNG MẪU (ENV TEMPLATE)
# Copy file này thành .env.local trên máy dev hoặc cấu hình trên Vercel Environment Variables
# KHÔNG BAO GIỜ COMMIT FILE .env HOẶC .env.local LÊN GITHUB!
# ==============================================================================

# 1. Supabase Cloud Database (Serverless Backend)
# Lấy tại: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Lưu ý: Sử dụng Service Role Key để Backend có toàn quyền quản lý dữ liệu an toàn
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# 2. Xác thực và Bảo mật (Server-side Only)
# Chuỗi bí mật ký JWT token (tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=qlcn_super_secret_jwt_key_random_string_32_chars_2027

# Mật khẩu GVCN (Băm bcrypt hoặc chuỗi mật khẩu mạnh để server so khớp)
TEACHER_PASSWORD=
TEACHER_PASSWORD_HASH=

# 3. Cấu hình cổng chạy máy chủ nội bộ (Dev)
PORT=3000

